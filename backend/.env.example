PORT=5000
# Prefer mongodb+srv on most machines. If Node fails with querySrv ECONNREFUSED (common on some Windows DNS setups),
# use the Atlas "standard connection string" host list instead.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/societymanagement?retryWrites=true&w=majority
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
DNS_SERVERS=8.8.8.8,1.1.1.1
